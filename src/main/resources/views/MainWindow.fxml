<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="rootPane" minHeight="400.0" minWidth="300.0" prefHeight="600.0" prefWidth="400.0" stylesheets="@../css/main.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cassava.gui.MainWindow">
   <children>
      <Label alignment="CENTER" contentDisplay="CENTER" style="-fx-text-fill: #d62839; -fx-font-family: 'Vladimir Script'; -fx-font-size: 30px;" text="Cassava" textAlignment="CENTER" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="8.0">
         <padding>
            <Insets bottom="8.0" top="8.0" />
         </padding>
      </Label>
      <ToggleButton fx:id="darkModeToggle" mnemonicParsing="false" onAction="#handleToggleDarkMode" text="🌙" AnchorPane.rightAnchor="8.0" AnchorPane.topAnchor="8.0" />
      <TextField fx:id="userInput" onAction="#handleUserInput" AnchorPane.bottomAnchor="12.0" AnchorPane.leftAnchor="12.0" AnchorPane.rightAnchor="55.0" />
      <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput" text="Send" AnchorPane.bottomAnchor="12.0" AnchorPane.rightAnchor="12.0" />
      <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="ALWAYS" vvalue="1.0" AnchorPane.bottomAnchor="52.0" AnchorPane.leftAnchor="8.0" AnchorPane.rightAnchor="8.0" AnchorPane.topAnchor="58.0">
         <content>
            <VBox fx:id="dialogContainer" prefWidth="384.0" spacing="10.0" />
         </content>
      </ScrollPane>
   </children>
</AnchorPane>
